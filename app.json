{
  "expo": {
    "name": "calculadora-price-sac",
    "slug": "calculadora-price-sac",
    "scheme": "calculadora-price-sac",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
