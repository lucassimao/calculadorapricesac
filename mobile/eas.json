{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "channel": "development",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ANALYTICS_DRYRUN": "1"
      }
    },
    "preview": {
      "channel": "preview",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ANALYTICS_DRYRUN": "1",
        "RELEASE_TARGET": "preview"
      }
    },
    "internal": {
      "channel": "preview",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ANALYTICS_DRYRUN": "1"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "RELEASE_TARGET": "production"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6757717537"
      }
    },
    "closed": {
      "android": {
        "track": "alpha"
      }
    }
  }
}
