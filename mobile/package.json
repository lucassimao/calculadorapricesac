{
  "name": "calculadora-price-sac",
  "version": "1.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:exports:android": "node scripts/test-export-readback-android.mjs",
    "avd:maestro:cold": "bash scripts/start-maestro-avd.sh cold",
    "avd:maestro:fast": "bash scripts/start-maestro-avd.sh fast",
    "avd:maestro:prepare": "bash scripts/prepare-maestro-avd.sh",
    "avd:maestro:snapshot": "bash scripts/prepare-maestro-avd.sh --save-snapshot",
    "ui:maestro": "bash scripts/run-maestro-suite.sh top-level",
    "ui:maestro:android": "bash scripts/run-maestro-suite.sh top-level",
    "ui:maestro:readback": "bash scripts/run-maestro-suite.sh readback",
    "ui:maestro:captures": "bash scripts/run-maestro-suite.sh captures",
    "ui:maestro:all": "bash scripts/run-maestro-suite.sh all",
    "ota:preview": "RELEASE_TARGET=preview npx eas-cli@latest update --channel preview --environment preview",
    "ota:production": "RELEASE_TARGET=production npx eas-cli@latest update --channel production --environment production",
    "build:android:local": "eas build -p android --local --profile production",
    "build:android:local:internal": "eas build -p android --local --profile internal"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "^8.6.0",
    "@sentry/react-native": "^6.22.0",
    "expo": "~54.0.30",
    "expo-application": "~7.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.12",
    "expo-dev-client": "~6.0.20",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.21",
    "expo-iap": "^3.4.0",
    "expo-image-picker": "~17.0.10",
    "expo-insights": "~0.10.8",
    "expo-linking": "~8.0.11",
    "expo-localization": "~17.0.8",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.21",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-store-review": "~9.0.9",
    "expo-updates": "~29.0.16",
    "posthog-react-native": "^4.32.0",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-google-mobile-ads": "^16.0.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-worklets": "0.5.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/react": "~19.1.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-preset-expo": "^54.0.9",
    "eslint": "^9.39.2",
    "eslint-config-expo": "^10.0.0",
    "prettier": "^3.8.0",
    "react-test-renderer": "^19.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.16"
  },
  "private": true
}
